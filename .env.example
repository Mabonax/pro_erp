APP_NAME="Programme of Action ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://poa.example.org
PUBLIC_REGISTRATION_ENABLED=false
CITIZEN_ACCESS_PUBLIC_INTAKE_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=poaerp
DB_USERNAME=poaerp
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENT_LIBRARY_ROOT=/var/lib/poaerp/document-library
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=change-me-mail-user
MAIL_PASSWORD=change-me-mail-password
MAIL_FROM_ADDRESS=notifications@poa.org.za
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
BRAND_LOGO_PATH=logo.png

APP_PORT=8080
COMPOSE_PROJECT_NAME=poaerp
APP_ENV_FILE=.env
APP_RUNTIME_IMAGE=ghcr.io/mabonax/poa_erp-app:latest
WEB_RUNTIME_IMAGE=ghcr.io/mabonax/poa_erp-web:latest
RUN_MIGRATIONS=false
RUN_ACCESS_CONTROL_RESYNC=false
RUN_OPTIMIZE_ON_BOOT=false
APP_VALIDATE_ENV_ON_BOOT=true
WAIT_FOR_DB=true
WAIT_FOR_REDIS=true
DB_CONNECT_TIMEOUT=60
REDIS_CONNECT_TIMEOUT=60
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TIMEOUT=120
QUEUE_WORKER_MAX_TIME=3600
QUEUE_WORKER_QUEUES=default
SCHEDULER_INTERVAL=60
SCHEDULER_HEARTBEAT_TTL=180
BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_PATH=backups/database
BACKUP_RETENTION_DAYS=14
DB_DUMP_BINARY=mysqldump

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@poa.org.za
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
SUPER_ADMIN_SYNC_PASSWORD=false
BOT_MEMBER_NAME="Bot Member"
BOT_MEMBER_EMAIL=bot.member@poa.org.za
BOT_MEMBER_PASSWORD=change-me-bot-member-password
STAFF_USER_DEFAULT_PASSWORD=change-me-staff-password
STAFF_SEND_WELCOME_NOTIFICATION=false
