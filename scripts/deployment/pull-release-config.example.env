# Copy this file to /home/prograg9g3o8/deploy/poa-release/config.env
# Then set chmod 600 on the copied file.
# Do not place this file under public_html and do not put the token in cron.

GITHUB_TOKEN=replace_with_read_only_github_token
GITHUB_REPOSITORY=Mabonax/pro_erp
GITHUB_API_URL=https://api.github.com
RELEASE_TAG_PREFIX=poa-production-

DEPLOY_ROOT=/home/prograg9g3o8/deploy/poa-release
LOG_DIR=/home/prograg9g3o8/deploy/poa-release/logs
STATE_FILE=/home/prograg9g3o8/deploy/poa-release/state/deployment-state.json
LOCK_DIR=/home/prograg9g3o8/deploy/poa-release/locks
TMP_DIR=/home/prograg9g3o8/deploy/poa-release/tmp

ERP_PATH=/home/prograg9g3o8/apps/erp.programofaction.org
WEBSITE_PATH=/home/prograg9g3o8/apps/website
WEBSITE_PUBLIC_ROOT=/home/prograg9g3o8/public_html

ERP_URL=https://erp.programofaction.org
WEBSITE_URL=https://programofaction.org

PHP_BIN=/usr/bin/php
COMPOSER_BIN=/usr/local/bin/composer
CURL_BIN=/usr/bin/curl
TAR_BIN=/usr/bin/tar
SHA256_BIN=/usr/bin/sha256sum
RSYNC_BIN=/usr/bin/rsync

RETAIN_RELEASES=5
USE_SYMLINKS=auto
WEBSITE_PUBLIC_ROOT_MANAGED=0
